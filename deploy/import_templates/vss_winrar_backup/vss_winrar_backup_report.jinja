[[WINHUB_REPORT title="VSS WinRAR Backup - {{ job_title }}"]]
{% set ns = namespace(archives=0, bytes=0, warnings=0, retention_deleted=0) -%}
{% for result in results -%}
{% if result.data and result.data.archives -%}
{% set ns.archives = ns.archives + (result.data.archives|length) -%}
{% for archive in result.data.archives -%}
{% set ns.bytes = ns.bytes + (archive.size_bytes or 0) -%}
{% endfor -%}
{% endif -%}
{% if result.data and result.data.warnings -%}{% set ns.warnings = ns.warnings + (result.data.warnings|length) -%}{% endif -%}
{% if result.data and result.data.deleted_by_retention -%}{% set ns.retention_deleted = ns.retention_deleted + (result.data.deleted_by_retention|length) -%}{% endif -%}
{% endfor -%}
VSS WINRAR BACKUP
=================
Job: {{ job_title }}
Status: {% if ignored_results %}COMPLETED WITH ERRORS{% else %}SUCCESS{% endif %}

SUMMARY
-------
Successful endpoints: {{ results|length }}
Failed endpoints: {{ ignored_results|length }}
Archives created: {{ ns.archives }}
Total archive size: {{ (ns.bytes / 1048576)|round(2) }} MB
Warnings: {{ ns.warnings }}
Retention deletions: {{ ns.retention_deleted }}

{% if ignored_results %}
FAILED ENDPOINT DETAILS
-----------------------
{% for result in ignored_results %}
- Endpoint: {{ result.host }}
  Status: {{ result.status }}
  Error: {% if result.data and result.data.error %}{{ result.data.error }}{% else %}{{ result.log }}{% endif %}
{% endfor %}
{% endif %}
{% for result in results %}
========================================================================
ENDPOINT: {{ result.host }}
========================================================================
Project: {{ result.data.project }}
Task: {{ result.data.task }}
Destination: {{ result.data.backup_destination }}
Started: {{ result.data.started_at }}
Finished: {{ result.data.finished_at }}
Duration: {{ result.data.duration_seconds }} seconds

CREATED ARCHIVES
----------------
{% for archive in result.data.archives %}
- Archive: {{ archive.name }}
  Source: {{ archive.source }}
  Mode: {{ archive.mode }}
  Size: {{ archive.size_mb }} MB
  Verification: {{ archive.verification }}
  Destination: {{ archive.destination }}
{% else %}
- none
{% endfor %}

CONFIGURED SOURCES
------------------
Recursive sources:
{% for folder in result.data.recursive_folders %}
- {{ folder }}
{% else %}
- none
{% endfor %}

Single sources (full tree):
{% for folder in result.data.single_folders %}
- {{ folder }}
{% else %}
- none
{% endfor %}

{% if result.data.deleted_by_retention %}
DELETED BY RETENTION (older than {{ result.data.retention_days }} days)
----------------------------------------------------------------
{% for item in result.data.deleted_by_retention %}
- {{ item }}
{% endfor %}
{% endif %}
{% if result.data.warnings %}
WARNINGS
--------
{% for warning in result.data.warnings %}
- {{ warning }}
{% endfor %}
{% endif %}
{% endfor %}
