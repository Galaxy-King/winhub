[[WINHUB_REPORT title="Proxmox infrastructure inventory"]]
<h1>Proxmox infrastructure inventory</h1>
{% set total_checked = (results|length) + (ignored_results|length) %}
{% if not results %}{% set overall_status = 'FAILED' %}{% elif ignored_results %}{% set overall_status = 'PARTIAL' %}{% else %}{% set overall_status = 'SUCCESS' %}{% endif %}
<div style="border:2px solid {% if overall_status == 'SUCCESS' %}#237804{% elif overall_status == 'PARTIAL' %}#d48806{% else %}#b52b27{% endif %};padding:14px;background:{% if overall_status == 'SUCCESS' %}#f6ffed{% elif overall_status == 'PARTIAL' %}#fffbe6{% else %}#fff1f0{% endif %};">
<h2>Audit status: {{ overall_status }}</h2>
<table><thead><tr><th style="background:#d6e4ff;">Selected endpoints</th><th style="background:#d9f7be;">Successfully checked</th><th style="background:#ffccc7;">Failed / skipped</th></tr></thead><tbody><tr><td style="background:#f0f5ff;"><strong>{{ total_checked }}</strong></td><td style="background:#f6ffed;color:#237804;"><strong>{{ results|length }}</strong></td><td style="background:#fff1f0;color:#b52b27;"><strong>{{ ignored_results|length }}</strong></td></tr></tbody></table>
</div>
{% if ignored_results %}<div style="border:2px solid #d9534f;background:#fff4f4;padding:12px;margin:12px 0;"><h2>Skipped or failed endpoints</h2><table><thead><tr><th style="background:#d6e4ff;">Endpoint</th><th style="background:#ffccc7;">Status</th><th style="background:#fff1b8;">Details</th></tr></thead><tbody>{% for failed in ignored_results %}<tr><td style="background:#f0f5ff;"><code>{{ failed.host }}</code></td><td style="background:#fff1f0;">{{ failed.status }}</td><td style="background:#fffbe6;">{{ failed.log }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
<p><em>Capacity standard: 4 vCPU, 16 GiB RAM and 150 GiB on storage ID <code>local</code> per new VM. CPU capacity is physical threads × 3. Other storage is excluded.</em></p>

{% for result in results %}
<hr style="border:0;border-top:5px solid #34495e;margin:30px 0 18px;" />
<h1>{{ result.data.collector_node }}{% if result.data.cluster != 'standalone' %} — cluster {{ result.data.cluster }}{% else %} — standalone{% endif %}</h1>
<p>Endpoint: <code>{{ result.host }}</code> · UTC: {{ result.data.generated_at }} · Guests: <strong>{{ result.data.summary.guests }}</strong> · Running: <strong>{{ result.data.summary.running }}</strong> · Stopped: <strong>{{ result.data.summary.stopped }}</strong></p>
{% for node in result.data.nodes %}
<h2>Node: {{ node.name }}</h2>
<table><thead><tr><th style="background:#d9f7be;">Status</th><th style="background:#bae7ff;">CPU threads</th><th style="background:#d6e4ff;">CPU usage</th><th style="background:#efdbff;">Total RAM GiB</th><th style="background:#ffe7ba;">Last reboot</th><th style="background:#b5f5ec;">Main IPv4 interfaces</th></tr></thead><tbody><tr><td style="background:#f6ffed;">{{ node.status }}</td><td style="background:#e6f7ff;">{{ node.cpu_count }}</td><td style="background:#f0f5ff;">{{ node.cpu_usage_pct }}%</td><td style="background:#f9f0ff;">{{ node.memory_total_gib }}</td><td style="background:#fff7e6;">{{ node.last_boot }}</td><td style="background:#e6fffb;">{% for nic in node.interfaces %}<code>{{ nic.name }}</code>: {{ nic.address }} ({{ nic.scope }}){% if not loop.last %}<br />{% endif %}{% else %}No public/private IPv4 found{% endfor %}</td></tr></tbody></table>

<div style="border:3px solid #1890ff;background:#e6f7ff;padding:16px;margin:14px 0;text-align:center;"><div>Capacity under the defined standard</div><div style="font-size:28px;font-weight:bold;color:#003a8c;">CAN CREATE {{ node.capacity.estimated_additional_vms }} MORE VM{% if node.capacity.estimated_additional_vms != 1 %}s{% endif %}</div><div>Limiting resource: <strong>{{ node.capacity.limiting_resource }}</strong></div></div>
<table><thead><tr><th style="background:#bae7ff;">CPU limit</th><th style="background:#efdbff;">RAM limit</th><th style="background:#ffe7ba;">Local disk limit</th><th style="background:#d6e4ff;">Allocated vCPU</th><th style="background:#efdbff;">Allocated RAM</th><th style="background:#ffd6e7;">Provisioned local</th><th style="background:#d9f7be;">Available local</th></tr></thead><tbody><tr><td style="background:#e6f7ff;">{{ node.capacity.cpu_vm_limit }} VM</td><td style="background:#f9f0ff;">{{ node.capacity.ram_vm_limit }} VM</td><td style="background:#fff7e6;">{% if node.capacity.has_local_storage %}{{ node.capacity.disk_vm_limit }} VM{% else %}No local storage{% endif %}</td><td style="background:#f0f5ff;">{{ node.capacity.allocated_vcpu }}</td><td style="background:#f9f0ff;">{{ node.capacity.allocated_ram_gib }} GiB</td><td style="background:#fff0f6;">{{ node.capacity.local_provisioned_gib }} GiB</td><td style="background:#f6ffed;">{{ node.capacity.local_available_gib }} GiB</td></tr></tbody></table>

<h3>Virtual machines and containers</h3>
<table><thead><tr><th style="background:#d6e4ff;">VMID</th><th style="background:#bae7ff;">Name</th><th style="background:#d9f7be;">Status</th><th style="background:#b5f5ec;">Type</th><th style="background:#e6f7ff;">vCPU</th><th style="background:#efdbff;">Allocated RAM</th><th style="background:#ffe7ba;">Configured disk</th><th style="background:#ffd6e7;">Local disk</th><th style="background:#fff1b8;">Pool / tags</th></tr></thead><tbody>
{% for vm in result.data.guests if vm.node == node.name %}<tr><td style="background:#f0f5ff;">{{ vm.vmid }}</td><td style="background:#e6f7ff;"><strong>{{ vm.name }}</strong>{% if vm.template %} (template){% endif %}</td><td style="background:{% if vm.status == 'running' %}#f6ffed{% else %}#fff1f0{% endif %};">{{ vm.status }}</td><td style="background:#e6fffb;">{{ vm.type }}</td><td style="background:#f0faff;">{{ vm.cpu_count }}</td><td style="background:#f9f0ff;">{{ vm.memory_allocated_gib }} GiB</td><td style="background:#fff7e6;">{{ vm.disk_allocated_gib }} GiB</td><td style="background:#fff0f6;">{% if vm.uses_local_storage %}{{ vm.local_disk_allocated_gib }} GiB{% else %}—{% endif %}</td><td style="background:#fffbe6;">{{ vm.pool }}{% if vm.pool and vm.tags %} / {% endif %}{{ vm.tags }}</td></tr>{% else %}<tr><td colspan="9">No guests on this node.</td></tr>{% endfor %}
</tbody></table>
{% endfor %}{% endfor %}
<hr style="border:0;border-top:5px solid #34495e;margin:30px 0 18px;" />
[[/WINHUB_REPORT]]
