WINHUB_ENV=production
SECRET_KEY=replace-with-64-random-characters

# Server runtime
HOST=127.0.0.1
PORT=8443
# Optional: run agent API/package downloads on a separate backend process.
# Leave empty for the classic single-backend mode.
# Set AGENT_BACKEND_PORT=8444 on servers where many local agents compete with the web UI.
AGENT_BACKEND_PORT=
DATA_DIR=/var/lib/winhub
NEWSLETTER_DATA_DIR=/var/lib/winhub/newsletter
SERVER_LOG_FILE=/var/log/winhub/winhub_prod.log
SERVER_CERT_PATH=/etc/winhub/certs/cert.pem
SERVER_KEY_PATH=/etc/winhub/certs/key.pem

# Newsletter inbound encrypted relay
# Enables polling an IMAP mailbox for encrypted messages with subjects like:
# [list:it-support] Maintenance notice
NEWSLETTER_INBOUND_ENABLED=false
NEWSLETTER_INBOUND_IMAP_HOST=mail.example.com
NEWSLETTER_INBOUND_IMAP_PORT=993
NEWSLETTER_INBOUND_IMAP_SSL=true
NEWSLETTER_INBOUND_IMAP_USER=news@example.com
NEWSLETTER_INBOUND_IMAP_PASSWORD=
NEWSLETTER_INBOUND_IMAP_FOLDER=INBOX
NEWSLETTER_INBOUND_PROCESSED_FOLDER=Processed
NEWSLETTER_INBOUND_FAILED_FOLDER=Failed
NEWSLETTER_INBOUND_POLL_SECONDS=60
# Comma-separated list of sender addresses allowed to trigger mailings. Use * only for isolated testing.
NEWSLETTER_INBOUND_ALLOWED_SENDERS=operator@example.com
# Optional. If empty, WinHUB uses the SMTP profile matching NEWSLETTER_INBOUND_IMAP_USER, then the first SMTP profile.
NEWSLETTER_INBOUND_SENDER_PROFILE=news@example.com
# Private-key passphrase for the mailbox GPG key. GPG decrypts through loopback mode, so no interactive prompt is needed.
NEWSLETTER_INBOUND_GPG_PASSPHRASE=

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=winhub
POSTGRES_USER=winhub
POSTGRES_PASSWORD=replace-with-strong-db-password

# Security / sessions
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Strict
SESSION_IDLE_TIMEOUT_SECONDS=21600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=0
HSTS_ENABLED=true

# Rate limiting. Keep memory:// for simple single-service deployment.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=
LOGIN_RATE_LIMIT=5 per minute
AGENT_ENROLLMENT_RATE_LIMIT=10 per minute

# Agent enrollment and task signing
AGENT_PUBLIC_PORT=443
# Optional absolute URL used inside agent update tasks for package downloads.
# Set this when agents reach WinHUB through a public proxy/WireGuard edge.
# Example: AGENT_PUBLIC_BASE_URL=https://203.0.113.10:55555
AGENT_PUBLIC_BASE_URL=
# absolute: WinHUB puts AGENT_PUBLIC_BASE_URL/current request URL into agent update tasks.
# relative: agents download update packages from their own configured ServerUrl.
# Use relative when one server manages both local agents and public-proxy agents.
AGENT_PACKAGE_URL_MODE=absolute
AGENT_API_KEY=replace-with-long-random-enrollment-secret
AGENT_ENROLLMENT_ENABLED=true
AGENT_ENROLLMENT_ALLOWLIST=
AGENT_ALLOW_REENROLL_EXISTING=false
AGENT_TASK_HMAC_SECRET=replace-with-different-long-random-hmac-secret
AGENT_REQUIRE_SIGNED_REQUESTS=false
AGENT_MAX_RESULT_LOG_BYTES=262144
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_PACKAGE_MAX_UPLOAD_MB=256
AGENT_IDLE_POLL_SECONDS=30
AGENT_TASK_POLL_SECONDS=30
AGENT_PENDING_POLL_SECONDS=30
AGENT_POLL_JITTER_SECONDS=30
AGENT_TELEMETRY_SECONDS=300
AGENT_PENDING_TASK_MISS_CACHE_SECONDS=10
LATEST_AGENT_VERSION=1.2.13

# Retention
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Mail / GPG for admin notifications
SENDER_EMAIL=admin@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_PASSWORD=
GPG_PATH=/usr/bin/gpg
GPG_HOME=/var/lib/winhub/gnupg
