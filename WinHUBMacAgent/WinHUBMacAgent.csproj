<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>WinHUBMacAgent</AssemblyName>
    <RootNamespace>WinHUBMacAgent</RootNamespace>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../WinHUBLinuxAgent/Worker.cs" Link="Worker.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <AgentDeployFile Include="winhub_agent.conf.example" />
    <AgentDeployFile Include="winhub_agent.bootstrap.conf.example" />
    <AgentDeployFile Include="com.winhub.agent.plist" />
    <AgentDeployFile Include="install-macos-agent.sh" />
    <AgentDeployFile Include="setup-macos-agent.sh" />
    <AgentDeployFile Include="uninstall-macos-agent.sh" />
    <AgentDeployFile Include="update-macos-agent.sh" />
    <AgentDeployFile Include="README.md" />
  </ItemGroup>
  <Target Name="CopyAgentDeployFiles" AfterTargets="Publish">
    <Copy SourceFiles="@(AgentDeployFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
