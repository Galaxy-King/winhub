<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.winhub.agent</string>
  <key>ProgramArguments</key>
  <array><string>/Library/PrivilegedHelperTools/com.winhub.agent/WinHUBMacAgent</string></array>
  <key>WorkingDirectory</key><string>/Library/PrivilegedHelperTools/com.winhub.agent</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/><key>NetworkState</key><true/></dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Library/Logs/WinHUB/agent.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/WinHUB/agent-error.log</string>
</dict>
</plist>
