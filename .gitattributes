* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep scripts and configuration portable across Windows, Linux, and macOS.
*.sh text eol=lf
*.service text eol=lf
*.plist text eol=lf
*.py text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.jinja text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf

# Release packages and media are binary.
*.zip binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
