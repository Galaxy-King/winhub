{% set ns = namespace(installed=0, missing=0, warnings=0) -%}
{% for result in results -%}
{% if result.data.software_installed -%}
{% set ns.installed = ns.installed + 1 -%}
{% else -%}
{% set ns.missing = ns.missing + 1 -%}
{% endif -%}
{% set ns.warnings = ns.warnings + (result.data.warnings|length) -%}
{% endfor -%}
{% set ordered = namespace(items=[]) -%}
