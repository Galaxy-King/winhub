{% if not insertion.done and candidate.data.ip_sort_key < current.data.ip_sort_key -%}
{% set insertion.items = insertion.items + [candidate] -%}
{% set insertion.done = true -%}
{% endif -%}
{% set insertion.items = insertion.items + [current] -%}
{% endfor -%}
{% if not insertion.done -%}
{% set insertion.items = insertion.items + [candidate] -%}
{% endif -%}
{% set ordered.items = insertion.items -%}
{% endfor -%}
