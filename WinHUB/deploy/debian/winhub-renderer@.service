[Unit]
Description=WinHUB isolated report renderer connection
Requires=winhub-renderer.socket
After=winhub-renderer.socket

[Service]
Type=exec
User=winhub-renderer
Group=winhub-renderer
WorkingDirectory=/opt/winhub
ExecStart=/opt/winhub/venv/bin/python -I /opt/winhub/core/report_renderer.py --worker --require-limits
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=15
RuntimeMaxSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
InaccessiblePaths=/etc/winhub /var/lib/winhub /var/log/winhub /root /home
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
KeyringMode=private
RemoveIPC=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~@network-io
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryMax=640M
TasksMax=8
UMask=0077
