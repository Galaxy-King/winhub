[Unit]
Description=WinHUB isolated static code validator
Requires=winhub-code-validator.socket
After=winhub-code-validator.socket

[Service]
Type=exec
User=winhub-validator
Group=winhub-validator
WorkingDirectory=/opt/winhub
ExecStart=/opt/winhub/venv/bin/python -I /opt/winhub/core/code_validator.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=35
TimeoutStartSec=10
KillMode=control-group
Environment=PATH=/usr/bin:/bin
Environment=DOTNET_EnableDiagnostics=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
InaccessiblePaths=/etc/winhub /var/lib/winhub /var/log/winhub /root /home
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
KeyringMode=private
RemoveIPC=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=~@network-io
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
MemoryMax=768M
TasksMax=64
UMask=0077
