<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>WinHUBLinuxAgent</AssemblyName>
    <RootNamespace>WinHUBLinuxAgent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AgentDeployFile Include="winhub_agent.conf.example" />
    <AgentDeployFile Include="winhub_agent.bootstrap.conf.example" />
    <AgentDeployFile Include="winhub-linux-agent.service" />
    <AgentDeployFile Include="install-linux-agent.sh" />
    <AgentDeployFile Include="uninstall-linux-agent.sh" />
    <AgentDeployFile Include="update-linux-agent.sh" />
    <AgentDeployFile Include="README.md" />
  </ItemGroup>

  <Target Name="CopyAgentDeployFiles" AfterTargets="Publish">
    <Copy SourceFiles="@(AgentDeployFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
