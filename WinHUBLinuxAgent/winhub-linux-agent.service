[Unit]
Description=WinHUB Linux endpoint agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/winhub-linux-agent
ExecStart=/opt/winhub-linux-agent/WinHUBLinuxAgent
Restart=always
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
LimitCORE=0
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
